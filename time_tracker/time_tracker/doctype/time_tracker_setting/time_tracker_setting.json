   "fieldname": "enable_employee_automation",
   "fieldtype": "Check",
   "label": "Enable Employee Automation"
  },
  {
   "default": "1",
   "depends_on": "enable_employee_automation",
   "description": "Create a permanent Time Tracker when the effective Salary Structure has Based on Time Tracker enabled.",
   "fieldname": "auto_create_time_tracker",
   "fieldtype": "Check",
   "label": "Auto Create Time Tracker"
  },
  {
   "default": "0",
   "depends_on": "enable_employee_automation",
   "fieldname": "auto_assign_salary_structure",
   "fieldtype": "Check",
   "label": "Auto Assign Salary Structure"
  },
  {
   "fieldname": "automation_column_break",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "depends_on": "enable_employee_automation",
   "fieldname": "auto_create_appraisal",
   "fieldtype": "Check",
   "label": "Auto Create Draft Appraisal"
  },
