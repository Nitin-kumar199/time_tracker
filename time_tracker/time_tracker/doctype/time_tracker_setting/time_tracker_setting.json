   "options": "Income Tax Slab"
  },
  {
   "depends_on": "eval:doc.enable_employee_automation && doc.auto_create_appraisal",
   "fieldname": "appraisal_section",
   "fieldtype": "Section Break",
   "label": "Appraisal"
  },
  {
   "fieldname": "appraisal_cycle",
   "fieldtype": "Link",
   "label": "Appraisal Cycle",
   "options": "Appraisal Cycle"
  },
  {
   "fieldname": "appraisal_template",
   "fieldtype": "Link",
   "label": "Fallback Appraisal Template",
   "options": "Appraisal Template"
  },
  {
   "depends_on": "eval:doc.enable_employee_automation && doc.auto_allocate_leave",
   "fieldname": "leave_section",
   "fieldtype": "Section Break",
   "label": "Leave Allocation"
  },
  {
   "fieldname": "leave_policy",
   "fieldtype": "Link",
   "label": "Leave Policy",
   "options": "Leave Policy"
  },
  {
   "default": "Joining Date",
