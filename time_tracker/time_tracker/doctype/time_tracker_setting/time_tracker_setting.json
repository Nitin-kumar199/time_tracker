   "fieldname": "currency",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Currency",
   "options": "Currency"
  },
  {
   "fieldname": "display_section",
   "fieldtype": "Section Break",
   "label": "Time Tracker and Payroll Display"
  },
  {
   "default": "1",
   "description": "Show readable Salary Slips on the employee's Time Tracker dashboard.",
   "fieldname": "show_salary_slip_on_time_tracker",
   "fieldtype": "Check",
   "label": "Show Salary Slip on Time Tracker"
  },
  {
   "description": "Print Format used when a Salary Slip is downloaded from Time Tracker.",
   "fieldname": "salary_slip_print_format",
   "fieldtype": "Link",
   "label": "Salary Slip Print Format",
   "options": "Print Format"
  },
  {
   "fieldname": "display_column_break",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Show the Pay Using Time Tracker checkbox on Payroll Entry for this company.",
   "fieldname": "show_pay_using_time_tracker_in_payroll_entry",
   "fieldtype": "Check",
   "label": "Show Pay Using Time Tracker in Payroll Entry"
  },
  {
   "fieldname": "tracker_automation_section",
   "fieldtype": "Section Break",
   "label": "Optional Employee Automation"
  },
