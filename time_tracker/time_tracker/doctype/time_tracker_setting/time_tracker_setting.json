   "label": "Leave Assignment Based On",
   "options": "Joining Date\nLeave Period"
  },
  {
   "fieldname": "leave_column_break",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.leave_assignment_based_on == 'Leave Period'",
   "fieldname": "leave_period",
   "fieldtype": "Link",
   "label": "Leave Period",
   "mandatory_depends_on": "eval:doc.leave_policy && doc.leave_assignment_based_on == 'Leave Period'",
   "options": "Leave Period"
  },
  {
   "default": "0",
   "fieldname": "carry_forward",
   "fieldtype": "Check",
   "label": "Carry Forward Existing Leave"
  },
  {
   "fieldname": "monthly_payroll_section",
   "fieldtype": "Section Break",
   "label": "Monthly Payroll Automation"
  },
  {
   "default": "0",
   "description": "Automatically create a monthly Time Tracker Payroll Entry and its Salary Slips for the previous calendar month. Salary Slips remain Draft for review.",
   "fieldname": "enable_auto_create_monthly_payroll",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Auto Create Payroll Entry and Salary Slips Every Month"
  },
  {
   "fieldname": "payroll_payable_account",
   "fieldtype": "Link",
   "label": "Payroll Payable Account",
   "mandatory_depends_on": "enable_auto_create_monthly_payroll",
   "options": "Account"
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "Cost Center",
   "mandatory_depends_on": "enable_auto_create_monthly_payroll",
   "options": "Cost Center"
  },
  {
   "fieldname": "monthly_payroll_column_break",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "fieldname": "exchange_rate",
   "fieldtype": "Float",
   "label": "Exchange Rate",
   "mandatory_depends_on": "enable_auto_create_monthly_payroll",
   "precision": 6
  },
  {
   "fieldname": "automation_help",
   "fieldtype": "HTML",
   "label": "Help",
   "options": "<p><strong>Based on Time Tracker</strong> on Salary Structure is independent from ERPNext's standard <strong>Salary Slip Based on Timesheet</strong> option. Monthly automation creates a submitted Payroll Entry and Draft Salary Slips from stopped, unpaid Tracker Logs.</p>"
  }
